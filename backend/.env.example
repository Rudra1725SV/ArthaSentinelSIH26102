# Supply DATABASE_URL, or all POSTGRES_* values. Never commit real credentials.
APP_NAME=ArthaSentinel API
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=artha_sentinel
POSTGRES_USER=
POSTGRES_PASSWORD=

# Optional: used by docker compose; DATABASE_URL takes precedence for the API.
# Do not use production credentials in this file.
