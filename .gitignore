# ──────────────────────────────────────────────
# Root-level .gitignore for Artha Sentinel
# ──────────────────────────────────────────────

# ── Environment / Secrets ────────────────────
.env
.env.*
!.env.example      # keep only the example template
*.pem
*.key
*.p12
*.pfx

# ── OS junk ──────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / IDE ─────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Logs ─────────────────────────────────────
*.log
*.stderr.log
*.stdout.log
logs/

# ── Python ───────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# ── Node / Next.js ───────────────────────────
node_modules/
.next/
out/
/build
.pnp
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── TypeScript ───────────────────────────────
*.tsbuildinfo

# ── Docker volumes / local data ──────────────
pgdata/
postgres_data/

# ── Vercel ───────────────────────────────────
.vercel
